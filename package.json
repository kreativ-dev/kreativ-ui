{
  "name": "@splenddev/kreativ-ui",
  "version": "0.2.9",
  "description": "A modern, themeable React UI component library with runtime theming, Tailwind CSS v4, and accessible components.",
  "type": "module",
  "author": {
    "name": "Felix Vincent",
    "url": "https://github.com/Vincentvirtuoso"
  },
  "license": "MIT",
  "homepage": "https://github.com/Vincentvirtuoso/kreativ-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vincentvirtuoso/kreativ-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Vincentvirtuoso/kreativ-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/styles/index.css"
  ],
  "keywords": [
    "react",
    "react-components",
    "react-ui",
    "ui-library",
    "component-library",
    "design-system",
    "themeable",
    "theming",
    "runtime-theming",
    "tailwindcss",
    "tailwindcss-v4",
    "typescript",
    "accessible",
    "ui-components",
    "kreativ-ui"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "default": "./dist/styles/index.css"
    },
    "./styles/index.css": {
      "default": "./dist/styles/index.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsup && npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/styles/index.css --minify",
    "postbuild": "node scripts/add-use-client.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.27.7": true
  }
}
